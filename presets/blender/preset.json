{
  "schema": 1,
  "name": "blender",
  "title": "Blender",
  "version": "1.0.0",
  "author": "HydraOps",
  "description": "Build and edit 3D scenes from the chat: objects, materials, lights, viewport captures and renders, through the MCP for Blender server.",
  "homepage": "https://github.com/ahujasid/blender-mcp",
  "server": {
    "command": "uvx",
    "args": [
      "mcp-for-blender==2.1.3"
    ],
    "env": {
      "BLENDER_HOST": "localhost",
      "BLENDER_PORT": "9876"
    }
  },
  "requires": {
    "notes": [
      "Blender 3.0 or newer, open while the agent works.",
      "The \"MCP for Blender\" add-on, enabled in Blender (it starts its own server when Blender opens)."
    ],
    "setup": [
      {
        "run": "uvx mcp-for-blender==2.1.3 install-addon",
        "then": "In Blender: Edit → Preferences → Add-ons → enable \"MCP for Blender\". Run this again after updating the connection."
      }
    ]
  },
  "toolRisk": {
    "get_addon_status": "neutral",
    "disable_telemetry": "acts",
    "get_scene_info": "neutral",
    "get_object_info": "neutral",
    "get_viewport_screenshot": "neutral",
    "execute_blender_code": "acts",
    "describe_node_type": "neutral",
    "bpy_api_lookup": "neutral",
    "get_polyhaven_categories": "read",
    "search_polyhaven_assets": "read",
    "get_polyhaven_asset_preview": "read",
    "download_polyhaven_asset": "both",
    "set_texture": "acts",
    "get_polyhaven_status": "neutral",
    "get_hyper3d_status": "neutral",
    "get_sketchfab_status": "neutral",
    "search_sketchfab_models": "read",
    "get_sketchfab_model_preview": "read",
    "download_sketchfab_model": "both",
    "get_polypizza_status": "neutral",
    "search_polypizza_models": "read",
    "download_polypizza_model": "both",
    "generate_hyper3d_model_via_text": "both",
    "generate_hyper3d_model_via_images": "both",
    "poll_rodin_job_status": "neutral",
    "import_generated_asset": "both",
    "get_hunyuan3d_status": "neutral",
    "generate_hunyuan3d_model": "both",
    "poll_hunyuan_job_status": "neutral",
    "import_generated_asset_hunyuan": "both",
    "get_tripo_status": "neutral",
    "generate_tripo_model": "both",
    "poll_tripo_job_status": "neutral",
    "import_generated_asset_tripo": "both",
    "export_scene": "acts",
    "record_trajectory_feedback": "acts"
  },
  "tips": [
    "Works best with a model that knows Blender's Python API (bpy).",
    "Ask the agent to take a viewport screenshot after it changes the scene, so it checks its own work."
  ]
}
